# Copy to .env for local use. .env is gitignored and is never copied into
# the Docker image (see .dockerignore) - pass real values to the container
# at run time instead.
#
# The deterministic decision API needs none of these to run: every variable
# below is optional and has a working default.

# Where the SQLite decision-snapshot database lives.
#
# Defaults to ./decisions.db, relative to the process working directory.
# The Docker image sets this to /data/decisions.db so the database lands on
# a mounted volume instead of the container's writable layer - snapshots are
# write-once records of what was recommended before a deadline, so a lost
# database cannot be regenerated.
# FPL_DB_PATH=decisions.db

# Port the API binds to. Defaults to 8000. Container hosts that inject their
# own $PORT (Cloud Run, Railway, Render) are honoured automatically.
# PORT=8000

# Only used by the optional legacy LLM agent layer in src/fpl_agent/agent/,
# which is not part of the deterministic decision path and is not reachable
# from any HTTP route. Leaving it unset is fine: the API runs without it and
# the agent-specialist tests skip themselves.
# OPENAI_API_KEY=
