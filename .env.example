# Copy to .env for local use. .env is gitignored and is never copied into
# the Docker image (see .dockerignore) - pass real values to the container
# at run time instead.
#
# The deterministic decision API needs none of these to run: every variable
# below is optional and has a working default.

# Where the SQLite decision-snapshot database lives.
#
# Defaults to ./decisions.db, relative to the process working directory.
# The Docker image sets this to /data/decisions.db so the database lands on
# a mounted volume instead of the container's writable layer - snapshots are
# write-once records of what was recommended before a deadline, so a lost
# database cannot be regenerated.
# FPL_DB_PATH=decisions.db

# Port the API binds to. Defaults to 8000. Container hosts that inject their
# own $PORT (Cloud Run, Railway, Render) are honoured automatically.
# PORT=8000

# Browser origins allowed to call this API, comma-separated.
#
# Required in production: the React frontend is deployed separately, so the
# browser calls this API cross-origin and every origin not listed here is
# refused. Set it to the deployed frontend's exact origin - scheme and host,
# no trailing slash and no path:
#
#   CORS_ALLOWED_ORIGINS=https://your-frontend.vercel.app
#
# Several origins (for example a preview deployment alongside production)
# are comma-separated. Surrounding whitespace is stripped, empty entries are
# ignored, and duplicates are removed, so this is equivalent to the line
# above:
#
#   CORS_ALLOWED_ORIGINS= https://your-frontend.vercel.app , ,
#
# Leave it unset for local development: it then falls back to the Vite dev
# server's own origins (localhost/127.0.0.1 on ports 5173 and 4173), which
# is also what an unconfigured deployment falls back to - so a forgotten
# variable fails closed against the internet rather than open.
#
# "*" is NOT allowed and is rejected outright - the API refuses to start
# rather than come up with a permissive policy. This applies whether it is
# the whole value or one entry among several, so both of these fail:
#
#   CORS_ALLOWED_ORIGINS=*
#   CORS_ALLOWED_ORIGINS=https://your-frontend.vercel.app,*
#
# A wildcard would let any site a visitor happens to be on read this API's
# responses from their browser. List exact origins instead.
# CORS_ALLOWED_ORIGINS=

# Only used by the optional legacy LLM agent layer in src/fpl_agent/agent/,
# which is not part of the deterministic decision path and is not reachable
# from any HTTP route. Leaving it unset is fine: the API runs without it and
# the agent-specialist tests skip themselves.
# OPENAI_API_KEY=
